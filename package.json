{
  "name": "backend-business-card",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend-визитка: NestJS, GraphQL и PostgreSQL",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "prisma migrate deploy",
    "seed": "node dist/prisma/seed.js",
    "test": "node --test dist/test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 dist/test/integration/*.test.js",
    "check": "pnpm generate && pnpm build && pnpm test",
    "format:check": "prettier --check src prisma/*.ts test scripts/*.mjs *.json *.yaml",
    "format": "prettier --write src prisma/*.ts test scripts/*.mjs *.json *.yaml"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "graphql": "^16.15.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "typescript": "^6.0.3"
  }
}
